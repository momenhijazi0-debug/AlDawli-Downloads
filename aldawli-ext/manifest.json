{
  "manifest_version": 3,
  "name": "الدولي للتحميلات",
  "version": "1.4",
  "description": "التقاط التنزيلات وفيديوهات يوتيوب وإنستغرام وإرسالها لبرنامج الدولي للتحميلات",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "video_btn.js"
      ],
      "run_at": "document_idle"
    }
  ]
}